 "assumptions": [
  {
   "id": "A-01",
   "label": "ASSUMPTION",
   "text": "Local projection eqc lat_ts=18.45, lon_0=77.45, R=3,396,190 m; lat_0=18.45 added only to move the origin (no scale change)."
  },
  {
   "id": "A-02",
   "label": "LIMITED",
   "text": "Slope limits 15/20/25\u00b0 (default 20\u00b0) and \u03b8pref 15\u00b0 are lunar-derived (20\u00b0: NASA 2020 Lunar Surface EVA ConOps; 15\u00b0: Pe\u00f1a-Asensio et al. 2023), not Mars suit limits."
  },
  {
   "id": "A-03",
   "label": "ASSUMPTION",
   "text": "Evidence penalty \u00d71.5 on CTX-only cells and blocking of no-data cells is a design preference, not measured risk."
  },
  {
   "id": "A-04",
   "label": "ASSUMPTION",
   "text": "Symmetric edge cost c = d\u00b7(1+(max slope/15\u00b0)\u00b2)\u00b7max penalty (model symmetric-max-v1); no uphill/downhill asymmetry."
  },
  {
   "id": "A-05",
   "label": "LIMITED",
   "text": "Return budgets 0.5/1/2/10 km-equivalent are demonstration presets (2 km: Artemis EVA ConOps radius; 10 km: Walkback Test, SAE 2007-01-3133); they do not validate a weighted budget or life support."
  },
  {
   "id": "A-06",
   "label": "ASSUMPTION",
   "text": "5 m routing cell slope = maximum 1 m Horn slope; cell HiRISE-supported only if \u2265 90 % of 1 m slopes valid."
  },
  {
   "id": "A-07",
   "label": "LIMITED",
   "text": "Station positions = last Perseverance waypoint at or before the sampling sol (Herd et al. 2025), \u00b15 m assumed."
  },
  {
   "id": "A-08",
   "label": "LIMITED",
   "text": "Depot inspection point = centroid of the 10 tube-drop rover positions from the PDS depot bundle; each tube lies within ~1-2 m of its rover position (assumed)."
  },
  {
   "id": "A-09",
   "label": "CONFIRMED",
   "text": "NASEM (2026) objective numbers 1 (habitability/life) and 3 (geologic record) on station cards checked against the report, doi:10.17226/28594, on 14 Nov 2026."
  },
  {
   "id": "A-10",
   "label": "ASSUMPTION",
   "text": "Snapping a blocked stop to the nearest traversable cell within 15 m is disclosed with its displacement; the requested point is preserved."
  },
  {
   "id": "A-11",
   "label": "ASSUMPTION",
   "text": "Ascent/descent use a 5-vertex (~25 m) moving average of 5 m-cell elevation; raw values reported alongside."
  },
  {
   "id": "A-12",
   "label": "ASSUMPTION",
   "text": "Scout score weights and normalisations are design choices; access uses the crew cost graph as a proxy (no robot mobility model)."
  }
 ],
